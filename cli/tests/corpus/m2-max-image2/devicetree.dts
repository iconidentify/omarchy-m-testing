		};
	};

	opp-table-gpu-cs {
		compatible = "operating-points-v2";
		phandle = <0x90>;

		opp00 {
			opp-hz = <0x00 0x18>;
			opp-microvolt = <0xa3160>;
		};

		opp01 {
			opp-hz = <0x00 0x1a76e700>;
			opp-microvolt = <0xa3160>;
