		opp15 {
			opp-hz = <0x00 0xc8458800>;
			opp-level = <0x0f>;
			clock-latency-ns = <0xfa00>;
			turbo-mode;
		};

		opp16 {
			opp-hz = <0x00 0xcb21f400>;
			opp-level = <0x10>;
			clock-latency-ns = <0xfa00>;
			turbo-mode;
		};

		opp17 {
			opp-hz = <0x00 0xd0dacc00>;
			opp-level = <0x11>;
			clock-latency-ns = <0xfa00>;
			turbo-mode;
		};
	};

	opp-table-gpu {
		compatible = "operating-points-v2";
		phandle = <0x8f>;

		opp00 {
			opp-hz = <0x00 0x00>;
			opp-microvolt = <0x61a80 0x61a80 0x61a80 0x61a80>;
			opp-microwatt = <0x00>;
		};

		opp01 {
			opp-hz = <0x00 0x1a76e700>;
			opp-microvolt = <0x9b848 0x9b848 0x9b848 0x9b848>;
			opp-microwatt = <0x418958>;
		};

		opp02 {
			opp-hz = <0x00 0x247a6100>;
			opp-microvolt = <0xa0280 0xa0280 0xa0280 0xa0280>;
			opp-microwatt = <0x5f61f8>;
		};

		opp03 {
