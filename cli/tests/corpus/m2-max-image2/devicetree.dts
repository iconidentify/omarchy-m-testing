					boot-stage@6001 {
						reg = <0x6001 0x01>;
						phandle = <0x2e>;
					};

					boot-error-count@6002,0 {
						reg = <0x6002 0x01>;
						bits = <0x00 0x04>;
						phandle = <0x2f>;
					};

					panic-count@6002,4 {
						reg = <0x6002 0x01>;
						bits = <0x04 0x04>;
						phandle = <0x30>;
					};

					boot-error-stage@6003 {
						reg = <0x6003 0x01>;
					};

					shutdown-flag@600f,3 {
						reg = <0x600f 0x01>;
						bits = <0x03 0x01>;
						phandle = <0x2d>;
					};

					fault-shadow@867b {
						reg = <0x867b 0x10>;
					};

					socd@8b00 {
						reg = <0x8b00 0x400>;
					};
				};
