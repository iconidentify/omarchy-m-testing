/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "apple,j416c", "apple,t6021", "apple,arm-platform";
	chassis-type = "laptop";
	model = "Apple MacBook Pro (16-inch, M2 Max, 2023)";

	aliases {
		gpu = "/soc/gpu@406400000";
		atcphy0 = "/soc/phy@703000000";
		atcphy1 = "/soc/phy@b03000000";
		atcphy2 = "/soc/phy@f03000000";
		atcphy3 = "/soc/phy@1303000000";
		bluetooth0 = "/soc/pcie@580000000/pci@0,0/bluetooth@0,1";
		dcp = "/soc/dcp@389c00000";
		dcpext0 = "/soc/dcp@289c00000";
		disp0 = "/soc/display-subsystem";
		disp0_piodma = "/soc/dcp@389c00000/piodma";
		serial0 = "/soc/serial@39b200000";
		sio = "/soc/sio@39bc00000";
		usb4-0-acio = "/soc/cio@701ac0000";
		usb4-0-nhi = "/soc/cio@701ac0000/nhi@f00000";
		usb4-0-pcie-adapter = "/soc/cio@701ac0000";
		usb4-0-pcie = "/soc/usb4-pcie-tunnel-0/pcie@730000000";
		usb4-1-acio = "/soc/cio@b01ac0000";
		usb4-1-nhi = "/soc/cio@b01ac0000/nhi@f00000";
		usb4-1-pcie-adapter = "/soc/cio@b01ac0000";
		usb4-1-pcie = "/soc/usb4-pcie-tunnel-1/pcie@b30000000";
		usb4-2-acio = "/soc/cio@f01ac0000";
		usb4-2-nhi = "/soc/cio@f01ac0000/nhi@f00000";
		usb4-2-pcie-adapter = "/soc/cio@f01ac0000";
		usb4-2-pcie = "/soc/usb4-pcie-tunnel-2/pcie@f30000000";
		usb4-3-pcie = "/soc/usb4-pcie-tunnel-3/pcie@1330000000";
		wifi0 = "/soc/pcie@580000000/pci@0,0/wifi@0,0";
		nvram = "/soc/spi@39b104000/flash@0/partitions/partition@700000";
		isp = "/soc/isp@384000000";
		dcpext1 = "/soc/dcp@315c00000";
		keyboard = "/soc/fifo@2a9b14000/input@8000/keyboard";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x01>;
				};

				core1 {
					cpu = <0x02>;
				};

				core2 {
					cpu = <0x03>;
				};

				core3 {
					cpu = <0x04>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x05>;
				};

				core1 {
					cpu = <0x06>;
				};

				core2 {
					cpu = <0x07>;
				};

				core3 {
					cpu = <0x08>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x09>;
				};

				core1 {
					cpu = <0x0a>;
				};

				core2 {
					cpu = <0x0b>;
				};

				core3 {
					cpu = <0x0c>;
				};
			};
		};

		cpu@0 {
			compatible = "apple,blizzard";
			device_type = "cpu";
			reg = <0x00 0x00>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0d>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0e>;
			capacity-dmips-mhz = <0x2f4>;
			performance-domains = <0x0f>;
			phandle = <0x01>;
		};

		cpu@1 {
			compatible = "apple,blizzard";
			device_type = "cpu";
			reg = <0x00 0x01>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0d>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0e>;
			capacity-dmips-mhz = <0x2f4>;
			performance-domains = <0x0f>;
			phandle = <0x02>;
		};

		cpu@2 {
			compatible = "apple,blizzard";
			device_type = "cpu";
			reg = <0x00 0x02>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0d>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0e>;
			capacity-dmips-mhz = <0x2f4>;
			performance-domains = <0x0f>;
			phandle = <0x03>;
		};

		cpu@3 {
			compatible = "apple,blizzard";
			device_type = "cpu";
			reg = <0x00 0x03>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x0d>;
			i-cache-size = <0x20000>;
			d-cache-size = <0x10000>;
			operating-points-v2 = <0x0e>;
			capacity-dmips-mhz = <0x2f4>;
			performance-domains = <0x0f>;
			phandle = <0x04>;
		};

		cpu@10100 {
			compatible = "apple,avalanche";
			device_type = "cpu";
			reg = <0x00 0x10100>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x10>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x05>;
		};

		cpu@10101 {
			compatible = "apple,avalanche";
			device_type = "cpu";
			reg = <0x00 0x10101>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x10>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x06>;
		};

		cpu@10102 {
			compatible = "apple,avalanche";
			device_type = "cpu";
			reg = <0x00 0x10102>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x10>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x07>;
		};

		cpu@10103 {
			compatible = "apple,avalanche";
			device_type = "cpu";
			reg = <0x00 0x10103>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x10>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x12>;
			phandle = <0x08>;
		};

		cpu@10200 {
			compatible = "apple,avalanche";
			device_type = "cpu";
			reg = <0x00 0x10200>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x13>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x14>;
			phandle = <0x09>;
		};

		cpu@10201 {
			compatible = "apple,avalanche";
			device_type = "cpu";
			reg = <0x00 0x10201>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x13>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x14>;
			phandle = <0x0a>;
		};

		cpu@10202 {
			compatible = "apple,avalanche";
			device_type = "cpu";
			reg = <0x00 0x10202>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x13>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x14>;
			phandle = <0x0b>;
		};

		cpu@10203 {
			compatible = "apple,avalanche";
			device_type = "cpu";
			reg = <0x00 0x10203>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
			next-level-cache = <0x13>;
			i-cache-size = <0x30000>;
			d-cache-size = <0x20000>;
			operating-points-v2 = <0x11>;
			capacity-dmips-mhz = <0x400>;
			performance-domains = <0x14>;
			phandle = <0x0c>;
		};

		l2-cache-0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x400000>;
			phandle = <0x0d>;
		};

		l2-cache-1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x1000000>;
			phandle = <0x10>;
		};

		l2-cache-2 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x1000000>;
			phandle = <0x13>;
		};
	};

	opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x0e>;

		opp02 {
			opp-hz = <0x00 0x365c0400>;
			opp-level = <0x02>;
			clock-latency-ns = <0x1e14>;
		};

		opp03 {
			opp-hz = <0x00 0x4c884900>;
			opp-level = <0x03>;
			clock-latency-ns = <0x61a8>;
		};

		opp04 {
			opp-hz = <0x00 0x686d6600>;
			opp-level = <0x04>;
			clock-latency-ns = <0x80e8>;
		};

		opp05 {
			opp-hz = <0x00 0x77729d00>;
			opp-level = <0x05>;
			clock-latency-ns = <0x9470>;
		};

		opp06 {
			opp-hz = <0x00 0x8677d400>;
			opp-level = <0x06>;
			clock-latency-ns = <0xabe0>;
		};

		opp07 {
			opp-hz = <0x00 0x907b4e00>;
			opp-level = <0x07>;
			clock-latency-ns = <0xbb80>;
		};
	};

