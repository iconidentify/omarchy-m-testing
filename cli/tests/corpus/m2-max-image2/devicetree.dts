			compatible = "apple,t6020-sart", "apple,t6000-sart";
			reg = <0x03 0x4bc50000 0x00 0x10000>;
			power-domains = <0xe9>;
			phandle = <0x142>;
		};

		nvme@34bcc0000 {
			compatible = "apple,t6020-nvme-ans2", "apple,t8103-nvme-ans2", "apple,nvme-ans2";
			reg = <0x03 0x4bcc0000 0x00 0x40000 0x03 0x47400000 0x00 0x4000>;
			reg-names = "nvme", "ans";
			interrupt-parent = <0x15>;
			interrupts = <0x00 0x00 0x728 0x04>;
			mboxes = <0x141>;
			apple,sart = <0x142>;
			power-domains = <0xe9 0xea 0x143>;
			power-domain-names = "ans", "apcie0", "apcie1";
			resets = <0xe9>;
		};
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			status = "disabled";
			panel = <0x144>;
			post-init-providers = <0x144>;
			power-domains = <0x1c 0x102>;
		};
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0x00 0x02 0x00>;
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			pwms = <0x145 0x00 0x9c40>;
			label = "kbd_backlight";
			function = "kbd_backlight";
			color = <0x00>;
			max-brightness = <0xff>;
			default-state = "keep";
		};
	};

	sound {
		compatible = "apple,j416-macaudio", "apple,j316-macaudio", "apple,macaudio";
		model = "MacBook Pro J416";

		dai-link@0 {
			link-name = "Speakers";
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-idle-mode-3 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0f0>;
			dai-tdm-slot-tx-idle-mask-3 = <0xf0f0f>;

			cpu {
				sound-dai = <0x146 0x00 0x146 0x01>;
			};

			codec {
				sound-dai = <0x147 0x148 0x149 0x14a 0x14b 0x14c>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <0x146 0x02>;
			};

			codec {
				sound-dai = <0x14d>;
			};
		};
	};
};
