		};
	};

	opp-table-gpu-afr {
		compatible = "operating-points-v2";
		phandle = <0x91>;

		opp00 {
			opp-hz = <0x00 0x18>;
			opp-microvolt = <0xa3160>;
		};

		opp01 {
			opp-hz = <0x00 0x17d78400>;
			opp-microvolt = <0xa3160>;
		};

		opp02 {
			opp-hz = <0x00 0x20e6da00>;
