<% content_for :title, "Delete report" %>
<%= card "delete report", klass: "narrow" do %>
  <h1>Delete this report?</h1>
  <p>This permanently removes the <%= @report.machine["model"] %> report uploaded <%= uploaded_at(@report) %>, with all its evidence. It can't be undone.</p>
  <%= button_to "Delete report", report_path(@report), method: :delete, params: { token: params[:token] }, class: "button button-danger" %>
<% end %>
