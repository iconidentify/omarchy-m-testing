<% content_for :title, "Reports" %>
<h1>Reports</h1>
<p class="subtitle">Every run, newest first. Community reports show up right away; they colour the matrix once another machine agrees. Tester runs colour it on their own.</p>
<% if @build %><p class="filters">Runs on build <strong><%= @build %></strong> · <%= link_to "every build", reports_path %></p><% end %>
<%= card "#{@reports.size} reports" do %>
  <%= render "shared/report_list", reports: @reports %>
<% end %>
