<% content_for :title, "Admin" %>
<h1>Admin</h1>
<p class="subtitle"><a href="<%= admin_testers_path %>">Testers</a><% if admin_login %> · signed in as @<%= admin_login %><% end %> <%= button_to "Sign out", admin_session_path, method: :delete, class: "button button-small", form: { class: "inline" } %></p>
<%= card "all reports (#{@reports.size})" do %>
  <table class="list">
    <thead><tr><th>Uploaded</th><th>Report</th><th>Mac</th><th>Stack / version</th><th>Run</th><th>State</th><th></th></tr></thead>
    <tbody>
      <% @reports.each do |report| %>
        <tr class="admin-row" id="admin-report-<%= report.public_id %>">
          <td class="nowrap"><%= uploaded_at(report) %></td>
          <td><a href="<%= report_path(report) %>"><%= report.public_id.first(8) %></a></td>
          <td><%= report.short_model_name %></td>
          <td><%= report.configuration(by_build: false).label %> <%= build_summary(report) %></td>
          <td><%= report.tester? ? tag.span("tester @#{report.tester_login}", class: "badge badge-tester") : tag.span("community", class: "badge badge-community") %></td>
          <td><%= report.hidden? ? tag.span("hidden", class: "badge badge-regression") : tag.span("visible", class: "badge badge-works") %></td>
          <td class="actions">
            <% if report.hidden? %>
              <%= button_to "Show", unhide_admin_report_path(report), method: :patch, class: "button button-small" %>
            <% else %>
              <%= button_to "Hide", hide_admin_report_path(report), method: :patch, class: "button button-small" %>
            <% end %>
            <%= button_to "Delete", admin_report_path(report), method: :delete, class: "button button-small button-danger",
                  form: { onsubmit: "return confirm('Delete this report and its evidence for good?')" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
