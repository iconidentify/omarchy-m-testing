{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "site/Dockerfile",
    "watchPatterns": ["site/**", "schema/**", "catalogue/catalogue.json", "installer/install.sh", "railway.json"]
  },
  "deploy": {
    "preDeployCommand": ["bin/rails db:prepare"],
    "healthcheckPath": "/up",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
